# verifier-service environment template. Copy to .env and fill in.
# Never commit a real .env (it is gitignored).

# Fastify server
PORT=3000
HOST=127.0.0.1

# EVM RPC endpoint the attestation signer reads chainId / verifyingContract from.
# Testnet only (Sepolia / Base Sepolia / Arbitrum Sepolia). No mainnet.
RPC_URL=

# Deployed IdentityVerifier address the attestation is bound to (verifyingContract).
IDENTITY_VERIFIER_ADDRESS=

# Operational signer key that holds SIGNER_ROLE on IdentityVerifier.
# Test key only. Rotate via grantRole/revokeRole on key compromise.
# secp256k1 (on-chain), distinct from the Ed25519 did:web keys below.
SIGNER_PRIVATE_KEY=

# did:web identities (SSI layer, Ed25519 — separate from SIGNER_PRIVATE_KEY).
ISSUER_DID=did:web:gated-vault-issuer.example
VERIFIER_DID=did:web:gated-vault-verifier.example

# 32-byte hex seed that derives the verifier's Ed25519 did:web key.
# A real deployment generates this securely and never commits it; the
# committed .well-known/did.json is built from a documented TEST seed only.
VERIFIER_DID_SEED=
ISSUER_DID_SEED=
